    {
      "atomType": "Code",
      "x": 0.44332493702770776,
      "y": 0.8729411764705881,
      "uniqueID": "id-123",
      "ioValues": [
        {
          "name": "width",
          "ioValue": 20
        },
        {
          "name": "depth",
          "ioValue": 20
        },
        {
          "name": "thickness",
          "ioValue": 5,
          "currentEquation": "5"
        },
        {
          "name": "holeRadius",
          "ioValue": 3
        },
        {
          "name": "color",
          "ioValue": "#00ff00",
          "currentEquation": "#00ff00"
        },
        {
